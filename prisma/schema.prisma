// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String          @id @default(cuid())
  name      String
  email     String          @unique
  password  String?         // Fica vazio até o aluno criar a senha pelo link do e-mail
  role      String          @default("STUDENT") // "ADMIN" ou "STUDENT"
  turma     String          @default("T3")      // Ex: "T1", "T2", "T3", "ALL"
  status    String          @default("Convite Enviado")
  createdAt DateTime        @default(now())
  progress  VideoProgress[]
}

model Module {
  id               String   @id @default(cuid())
  tag              String
  title            String
  subtitle         String
  turmasPermitidas String[] // Array de turmas que podem ver (ex: ["T3"])
  videos           Video[]
  createdAt        DateTime @default(now())
}

model Video {
  id          String          @id @default(cuid())
  number      String
  title       String
  description String
  duration    String
  thumbnail   String
  videoUrl    String
  materialUrl String?
  moduleId    String
  module      Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  progress    VideoProgress[]
}

model CalendarEvent {
  id         String   @id @default(cuid())
  date       String   // Ex: "28 NOV"
  dayOfWeek  String   // Ex: "Sábado"
  time       String   // Ex: "10:00 - 12:00"
  title      String
  category   String
  status     String   @default("Confirmado")
  meetingUrl String
  createdAt  DateTime @default(now())
}

model Banner {
  id        String   @id @default("principal")
  titulo    String
  descricao String
  imagemUrl String
  videoUrl  String
  updatedAt DateTime @updatedAt
}

model VideoProgress {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  completed Boolean  @default(true)
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}